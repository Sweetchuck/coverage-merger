<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../vendor/phpunit/phpunit/phpunit.xsd"
    cacheResult="false"
    colors="true">

    <source>
        <include>
            <directory>./src/</directory>
        </include>
    </source>

    <testsuites>
        <testsuite name="Unit">
            <directory>./tests/</directory>
        </testsuite>
    </testsuites>
</phpunit>
